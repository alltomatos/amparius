# Amparius — ambiente de desenvolvimento local.
# Copie para .env se quiser customizar. Valores são de DEV; nada de segredo de produção.

POSTGRES_USER=amparius
POSTGRES_PASSWORD=amparius
POSTGRES_DB=amparius
POSTGRES_PORT=5432

# Papel de aplicação (amparius_app/amparius_control_app) criado por
# scripts/bootstrap-e2e.ps1 antes das migrations, igual ao bootstrap de
# staging (deploy/staging/bootstrap.sh). Credencial de DEV local apenas.
POSTGRES_APP_USER=amparius_app
POSTGRES_APP_PASSWORD=amparius_app
POSTGRES_CONTROL_APP_USER=amparius_control_app
POSTGRES_CONTROL_APP_PASSWORD=amparius_control_app

# As rotas /_dev/* (onboarding e parties) exigem APP_ENV=development e este opt-in explícito.
ENABLE_DEV_ONBOARDING=false

REDIS_PORT=6379

RABBITMQ_USER=amparius
RABBITMQ_PASS=amparius
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Object storage S3-compatible (Cloudflare R2, S3 ou endpoint local). O vazio
# mantém a API executável, mas /readyz falha fechado até a configuração existir.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=amparius
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_USE_PATH_STYLE=false

# Worker da outbox (OUT-01C). Metricas em loopback por padrao; use off para desabilitar.
LOG_LEVEL=info
READINESS_TIMEOUT=2s
OUTBOX_BATCH=50
OUTBOX_MAX_TENANTS=100
OUTBOX_LEASE=5m
OUTBOX_INTERVAL=5s
OUTBOX_DELIVERY_HANDLER=delivery
OUTBOX_METRICS_ADDR=127.0.0.1:9091
