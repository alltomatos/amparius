# Copie para .env e preencha por secret store. Nunca faça commit do .env.
POSTGRES_ADMIN_USER=amparius_admin
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_APP_USER=amparius_app
POSTGRES_APP_PASSWORD=change-me
RABBITMQ_USER=amparius
RABBITMQ_PASS=change-me

# Object storage S3-compatible (R2, S3 ou endpoint privado). Preencher por
# secret store; readiness permanece 503 enquanto os campos obrigatórios faltarem.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=amparius
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_USE_PATH_STYLE=false

# Opcional: imagem anterior para rollback.
API_IMAGE=amparius-api:staging
